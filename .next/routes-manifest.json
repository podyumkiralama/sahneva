    },
    {
      "page": "/projeler/kapali-alan-led-sahne-kurulumu",
      "regex": "^/projeler/kapali\\-alan\\-led\\-sahne\\-kurulumu(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/projeler/kapali\\-alan\\-led\\-sahne\\-kurulumu(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
