// app/sitemap-images.xml/route.js
import { NextResponse } from "next/server";
import { services } from "@/lib/data";

const SITE = "https://www.sahneva.com";

// Her URL için image listesi üret
function collectImageEntries() {
  // Statik sayfalar (örnek görseller, elindeki /public/img/... yollarıyla eşleştir)
  const staticImages = [
    {
      loc: `${SITE}/`,
      imgs: [
        { loc: `${SITE}/img/hero-bg.webp`, title: "Sahneva Hero", caption: "Sahne, podyum, LED ekran ve ses-ışık" },
      ],
    },
    {
      loc: `${SITE}/hizmetler`,
      imgs: [
        { loc: `${SITE}/img/hizmetler/overview.webp`, title: "Hizmetler", caption: "Tüm hizmetler genel bakış" },
      ],
    },
  ];

  // Servis sayfaları (services[*].images dizisini kullan)
  const serviceImages = (services ?? []).map((s) => ({
    loc: `${SITE}/${s.slug}`,
    imgs: (s.images ?? []).map((src) => ({
      loc: `${SITE}${src}`,
      title: s.title ?? s.slug,
      caption: s.caption ?? s.title ?? s.slug,
    })),
  }));

  return [...staticImages, ...serviceImages];
}

export async function GET() {
  const entries = collectImageEntries();

  const xmlParts = [
    `<?xml version="1.0" encoding="UTF-8"?>`,
    `<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">`,
  ];

  for (const { loc, imgs } of entries) {
    xmlParts.push(`<url>`);
    xmlParts.push(`<loc>${loc}</loc>`);
    for (const img of imgs ?? []) {
      xmlParts.push(`<image:image>`);
      xmlParts.push(`<image:loc>${img.loc}</image:loc>`);
      if (img.caption) xmlParts.push(`<image:caption>${escapeXml(img.caption)}</image:caption>`);
      if (img.title)   xmlParts.push(`<image:title>${escapeXml(img.title)}</image:title>`);
      xmlParts.push(`</image:image>`);
    }
    xmlParts.push(`</url>`);
  }

  xmlParts.push(`</urlset>`);
  const body = xmlParts.join("");

  return new NextResponse(body, {
    headers: { "Content-Type": "application/xml; charset=utf-8", "Cache-Control": "public, max-age=3600" },
  });
}

function escapeXml(s = "") {
  return s.replace(/[<>&'"]/g, (c) => ({ "<":"&lt;","&": "&amp;",">":"&gt;","'":"&apos;",'"':"&quot;" }[c]));
}