d:T2afa,{"@context":"https://schema.org","@type":"FAQPage","@id":"https://www.sahneva.com/sss#faq","inLanguage":"tr-TR","mainEntity":[{"@type":"Question","name":"Kurumsal etkinlik tecrübemiz var mı?","acceptedAnswer":{"@type":"Answer","text":"Evet. Lansman, konferans, bayi toplantısı, miting ve konser gibi geniş yelpazede yüzlerce etkinlik deneyimimiz var."}},{"@type":"Question","name":"Ekipmanlarınız güncel mi? Bakımlar nasıl yapılır?","acceptedAnswer":{"@type":"Answer","text":"Tüm ekipmanlar periyodik bakımdan geçirilir ve her iş öncesi fonksiyon testleri yapılır. Kritik cihazlarda yedekleme ile çalışırız."}},{"@type":"Question","name":"Etkinlik günü teknik ekip büyüklüğü nedir?","acceptedAnswer":{"@type":"Answer","text":"Kapsama göre değişir. Küçük etkinliklerde 2–3 kişi, büyük kurulumlarda sahne, ses, ışık, görüntü ve kamera ekipleri dahil 10+ kişilik kadro görev alır."}},{"@type":"Question","name":"Keşif yapıyor musunuz? Ücretli mi?","acceptedAnswer":{"@type":"Answer","text":"Gerekli görülen projelerde ücretsiz keşif yapıyoruz. Mekân ölçümü, elektrik erişimi ve yükleme–boşaltma koşulları yerinde değerlendirilir."}},{"@type":"Question","name":"Fiyatlandırma nasıl belirleniyor?","acceptedAnswer":{"@type":"Answer","text":"Fiyat; ekipman kalemi, süre (kurulum + etkinlik + söküm), şehir ve lojistik, gerekli personel ve aksesuarlar üzerinden netleştirilir. İhtiyacınıza göre alternatif paketler sunuyoruz."}},{"@type":"Question","name":"Türkiye genelinde hizmet veriyor musunuz?","acceptedAnswer":{"@type":"Answer","text":"Evet. İstanbul merkezli ekibimizle Türkiye’nin tamamında çalışıyoruz. Şehir dışı işler için sevkiyat ve konaklama planını teklif aşamasında şeffaf şekilde paylaşıyoruz."}},{"@type":"Question","name":"Rezervasyon ve iptal koşulları nedir?","acceptedAnswer":{"@type":"Answer","text":"Rezervasyon avans ödemesi ile kesinleşir. İptallerde tarih yakınlığına göre üretim/lojistik maliyetleri kesilerek iade süreçleri sözleşmede tanımlanır."}},{"@type":"Question","name":"Etkinlik günü sorumlular kimler olur?","acceptedAnswer":{"@type":"Answer","text":"Her projede bir saha sorumlusu bulunur. Ses, ışık, görüntü, sahne/rigging ve genel koordinasyon ayrı personeller tarafından yönetilir."}},{"@type":"Question","name":"Podyum kurulumu ne kadar sürer?","acceptedAnswer":{"@type":"Answer","text":"Standart 6×4 m modüler podyumun kurulumu ortalama 60–90 dakika sürer. Ölçü, zemin ve erişime göre süre değişebilir."}},{"@type":"Question","name":"Zemine zarar verir mi?","acceptedAnswer":{"@type":"Answer","text":"Kaymaz kaplama ve kauçuk ayaklar sayesinde podyum zemine zarar vermez. İç/dış mekânda güvenle kullanılır."}},{"@type":"Question","name":"Yükseklik ve ölçü seçenekleri neler?","acceptedAnswer":{"@type":"Answer","text":"Modüler sistemle 20–100 cm kademeli yükseklik; 1×2 m panellerle istenen ölçüde kurulum yapılır."}},{"@type":"Question","name":"Podyum güvenliği için hangi önlemler alınıyor?","acceptedAnswer":{"@type":"Answer","text":"Korkuluk, rampa, merdiven ve yük hesapları standart güvenlik protokolüyle planlanır. Kenar–köşe kaplamaları ve sabitlemeler kurulumda uygulanır."}},{"@type":"Question","name":"Dış mekânda podyum kurulabilir mi?","acceptedAnswer":{"@type":"Answer","text":"Evet. Zemin tesviyesi, rüzgâr ve yağış senaryolarına göre sabitleme/örtüleme uygulanır. Detaylar keşifte netleştirilir."}},{"@type":"Question","name":"Podyum üstü kaplama ve brandalama yapıyor musunuz?","acceptedAnswer":{"@type":"Answer","text":"Siyah podyum eteği standarttır. Marka rengine uygun ön yüzey, logolu branda ve özel kaplama opsiyoneldir."}},{"@type":"Question","name":"Sahne ile podyum arasındaki fark nedir?","acceptedAnswer":{"@type":"Answer","text":"Podyum; konuşmacı, ödül töreni ve defile gibi yükü nispeten düşük kurgular içindir. Sahne; truss/rigging, ışık/ekran asımı gibi ağır yükler ve yüksek platform gerektiren prodüksiyonlar için tercih edilir. Detaylar: /podyum-kiralama ve /sahne-kiralama."}},{"@type":"Question","name":"Podyum kiralamak için nasıl teklif alabilirim?","acceptedAnswer":{"@type":"Answer","text":"İhtiyacınızı /podyum-kiralama sayfasından veya +90 545 304 8671 numarasından iletebilirsiniz. Keşif sonrası net ölçü ve fiyat paylaşırız."}},{"@type":"Question","name":"Dış mekânda kullanılabilir mi?","acceptedAnswer":{"@type":"Answer","text":"Evet. IP65 sınıfı paneller yağmur ve toza dayanıklıdır. Gündüz kullanımında yüksek parlaklık sağlanır."}},{"@type":"Question","name":"Hangi çözünürlükleri sunuyorsunuz?","acceptedAnswer":{"@type":"Answer","text":"P2–P5 arası iç/dış mekân panellerimiz bulunur. İzleme mesafesi ve sahne genişliğine göre doğru pitch önerilir."}},{"@type":"Question","name":"İçerik yönetimini kim yapıyor?","acceptedAnswer":{"@type":"Answer","text":"Video miksaj ve içerik geçişleri teknik ekibimiz tarafından canlı olarak yönetilir."}},{"@type":"Question","name":"Gündüz güneşte görünürlük nasıl sağlanıyor?","acceptedAnswer":{"@type":"Answer","text":"Yüksek nit değerli paneller, uygun renk–kontrast kalibrasyonu ve doğru yerleşim ile gündüz net görünürlük elde edilir."}},{"@type":"Question","name":"Elektrik ihtiyacı nedir? Jeneratör gerekiyor mu?","acceptedAnswer":{"@type":"Answer","text":"Ekran ölçüsü ve parlaklığa göre tek/üç faz enerji gereksinimi değişir. Şebekenin yetersiz olduğu açık alanlarda sessiz jeneratör öneririz."}},{"@type":"Question","name":"Ekran oranı ve içerik nasıl olmalı?","acceptedAnswer":{"@type":"Answer","text":"16:9 ana ekran önerilir. Yan destek ekranlar ve sahne içi bantlar için içerik ayrı hazırlanır. Reji üzerinden çoklu kaynak mikslenir."}},{"@type":"Question","name":"Canlı yayın veya kamera girişi yapılabilir mi?","acceptedAnswer":{"@type":"Answer","text":"Evet. SDI/HDMI kaynaklar miksere bağlanarak canlı kameralar, sunum ve videolar aynı anda yönetilir."}},{"@type":"Question","name":"Kurulum süresi ve teknik ekip desteği nasıl?","acceptedAnswer":{"@type":"Answer","text":"Ölçüye göre 60–180 dakika arasında kurulum tamamlanır. Etkinlik boyunca LED operatörü ve reji ekibi sahada kalır."}},{"@type":"Question","name":"LED ekran kiralamada fiyatı etkileyen kalemler neler?","acceptedAnswer":{"@type":"Answer","text":"Pitch, metrekare, iç/dış mekân, kurulum yüksekliği, reji–kamera ihtiyacı ve etkinlik süresi toplam maliyeti belirler."}},{"@type":"Question","name":"Teknik ekip sağlıyor musunuz?","acceptedAnswer":{"@type":"Answer","text":"Kurulum, test ve etkinlik boyunca operatörlerimiz sahada aktif görev alır; tüm süreç teknik ekip tarafından yönetilir."}},{"@type":"Question","name":"Mikrofon ve kayıt çözümleri var mı?","acceptedAnswer":{"@type":"Answer","text":"Kablosuz el/yaka mikrofonları, çok kanallı miksaj ve çok izli kayıt çözümlerimiz mevcut. Simultane altyapı kurulabilir."}},{"@type":"Question","name":"Işık tasarımı yapıyor musunuz?","acceptedAnswer":{"@type":"Answer","text":"LED PAR, spot, wash ve efekt armatürleriyle mekâna uygun ışık planı hazırlanır; DMX ile sahnelenir."}},{"@type":"Question","name":"Konferans için kaç mikrofon gerekir?","acceptedAnswer":{"@type":"Answer","text":"Konuşmacı sayısı ve oturma düzenine göre el, yaka (lav), kürsü ve ortam mikrofonları kombine edilir."}},{"@type":"Question","name":"Küçük toplantı vs. açık hava konseri için ses sistemi nasıl ölçeklenir?","acceptedAnswer":{"@type":"Answer","text":"Katılımcı sayısı, alan tipi ve akustik koşullara göre line-array, sub dağılımı ve delay hoparlör noktaları planlanır."}},{"@type":"Question","name":"Elektrik güvenliği ve kablo düzeni nasıl sağlanıyor?","acceptedAnswer":{"@type":"Answer","text":"Tüm kablolar rampa ve bantla sabitlenir. Güç hatları kaçak akım rölesi ile korunur."}},{"@type":"Question","name":"Işıkta marka renklerine uygun sahneleme yapılabilir mi?","acceptedAnswer":{"@type":"Answer","text":"Evet. Gobo, renk paleti ve akış senaryosu kurumsal kimliğe göre programlanır."}},{"@type":"Question","name":"DJ/orkestra ile çalışırken koordinasyon nasıl?","acceptedAnswer":{"@type":"Answer","text":"Prova saatleri planlanır; reji, DJ ve ışık operatörü ortak cue list üzerinden ilerler."}},{"@type":"Question","name":"Kurulum ve söküm hizmeti dâhil mi?","acceptedAnswer":{"@type":"Answer","text":"Evet. Taşıma, kurulum ve söküm ekibimiz tarafından yapılır; güvenlik ankrajları ve ağırlıklandırma dâhildir."}},{"@type":"Question","name":"Boyut ve zemin koşulları nedir?","acceptedAnswer":{"@type":"Answer","text":"Farklı açıklıklarda çadır seçenekleri vardır. Zemin beton, asfalt veya düz toprak olabilir; seviye şap ile dengelenir."}},{"@type":"Question","name":"Isıtma/soğutma ve aydınlatma sağlıyor musunuz?","acceptedAnswer":{"@type":"Answer","text":"İsteğe bağlı klima/ısıtıcı ve genel aydınlatma sağlanır. Acil çıkış ve güvenlik şartları sağlanır."}},{"@type":"Question","name":"Rüzgârlı ve yağışlı havalarda çadır güvenli mi?","acceptedAnswer":{"@type":"Answer","text":"Doğru ankraj, ağırlıklandırma, gergi ve yan kapamalarla rüzgâr–yağış senaryolarına dayanım sağlanır."}},{"@type":"Question","name":"Zemin kaplama ve yürüyüş yolu yapılır mı?","acceptedAnswer":{"@type":"Answer","text":"Evet. Modüler platform, halı kaplama ve rampalı erişim seçenekleri sunuyoruz."}},{"@type":"Question","name":"Kiralama süresi uzatılabilir mi?","acceptedAnswer":{"@type":"Answer","text":"Müsaitliğe bağlı olarak süre uzatılabilir. Ek gün ücretleri sözleşmede belirtilir."}},{"@type":"Question","name":"Keşif ve fiyatlandırma nasıl ilerler?","acceptedAnswer":{"@type":"Answer","text":"İhtiyaçlar alındıktan sonra gerekirse ücretsiz keşif yapılır; net fiyat ve zaman planı sunulur."}},{"@type":"Question","name":"Teslimat bölgeleri ve zamanlama?","acceptedAnswer":{"@type":"Answer","text":"Türkiye genelinde çalışıyoruz. İstanbul içi aynı gün kurulum mümkün; şehir dışına planlı sevkiyat yapılır."}},{"@type":"Question","name":"Faturalandırma ve sözleşme süreçleri?","acceptedAnswer":{"@type":"Answer","text":"Tüm işler sözleşmeli ve e-faturalıdır. Rezervasyon, avans ve teslim tutanakları ile süreç tamamlanır."}},{"@type":"Question","name":"Ödeme yöntemleri ve vadeler nedir?","acceptedAnswer":{"@type":"Answer","text":"E-fatura, havale/EFT ve kurumsal sözleşmelerde tanımlı vade seçenekleri sunulur."}},{"@type":"Question","name":"Sigorta ve sorumluluk kapsamı nedir?","acceptedAnswer":{"@type":"Answer","text":"Saha güvenliği ve ekipman kullanımı Sahneva prosedürlerine uygun yapılır."}}]}a:["$","$1","c",{"children":[[["$","$L7",null,{"id":"ld-faq","type":"application/ld+json","strategy":"afterInteractive","dangerouslySetInnerHTML":{"__html":"$d"}}],"$Le"],null,"$Lf"]}]
